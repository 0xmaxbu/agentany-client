{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentAny 设备客户端",
  "version": "0.1.0",
  "identifier": "app.agentany.device",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentAny 设备客户端",
        "url": "index.html",
        "width": 580,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/agentany-host"]
  }
}
